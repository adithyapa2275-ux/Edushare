rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@edushare.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Users can read/write their own profile
      // Admin has full access
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // --- Listings Collection ---
    match /listings/{listingId} {
      // Anyone can browse listings
      allow read: if true;
      
      // Logged-in users can create listings
      allow create: if request.auth != null;
      
      // Only the owner or admin can update/delete
      allow update, delete: if request.auth != null && (
        request.resource.data.uploaderId == request.auth.uid || 
        resource.data.uploaderId == request.auth.uid ||
        isAdmin()
      );
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      // Users can read their own orders and create new ones
      // Admin can view all orders
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Typically orders shouldn't be updated/deleted by users after placement
      allow update, delete: if isAdmin();
    }
  }
}
